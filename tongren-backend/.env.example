# 复制为 .env 后按实际环境修改

# ---- MySQL 连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tongren

# ---- 安全 ----
# token 签名密钥，务必改成随机串
SECRET_KEY=change-me-to-a-long-random-string
# 登录 token 有效期（天）
TOKEN_EXPIRE_DAYS=30

# ---- 启动时自动建表（开发方便；生产建议 0，用 sql/schema.sql 手工建库）----
AUTO_CREATE_TABLES=1

# ---- 数据分析 pipeline 定时任务（每天凌晨跑批）----
ANALYTICS_SCHEDULER_ON=1
ANALYTICS_CRON_HOUR=3
ANALYTICS_CRON_MINUTE=30
