/* 自定义 tabBar：定位 + 安全区，其余样式全部复用 app.wxss 的 .tabbar / .tab-btn */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  box-shadow: 0 -5.73rpx 24.81rpx rgba(43, 70, 49, .06);
  padding-bottom: 9.54rpx;
  padding-bottom: calc(9.54rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(9.54rpx + env(safe-area-inset-bottom));
}
