/* ============================================================
   大美铜仁 · 微信小程序 全局样式
   由原型 index.html 的产品 CSS 自动转换而来 (393px -> 750rpx)
   规则：元素选择器 -> .tx-* 工具类；伪元素 -> 真实元素；
        grid -> flex；gap -> margin；aspect-ratio -> padding-top 比例盒
   ============================================================ */

page {
  --cream: #F7F7F0;
  --card: #FFFFFF;
  --ink: #2C2C27;
  --muted: #6B6B61;
  --brown: #756A5D;
  --line: #E8E8DE;
  --line-strong: #DCDCD0;
  --green-900: #2A4431;
  --green-800: #3A5B42;
  --green-700: #4E7A55;
  --green-600: #6B966F;
  --green-500: #96BB90;
  --green-300: #BFD5B9;
  --green-100: #E9F1E5;
  --green-50: #F2F7EF;
  --gold-bg: #FBF1DF;
  --gold: #8E5F24;
  --red-bg: #FBEDED;
  --red: #B45454;
  --sand: #F3EEE4;
  --sand-ink: #5E4F3F;
  --r-xl: 49.62rpx;
  --r-lg: 41.98rpx;
  --r-md: 30.53rpx;
  --r-sm: 19.08rpx;
  --sh-card: 0 15.27rpx 45.80rpx rgba(43, 70, 49, .055);
  --font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  --font-serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
  --ease: cubic-bezier(.22, .61, .36, 1);
  --tabbar-h: 133.59rpx;
  font-family: var(--font-sans);
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink);
  background: var(--cream);
}

view, text, button, input, image, scroll-view, swiper, swiper-item,
canvas, cover-view, cover-image { box-sizing: border-box; }
image { display: block; }
text { display: inline; }

.ico {
  display: inline-flex;
}
.tabbar {
  flex: none;
  height: var(--tabbar-h);
  display: flex;
  padding: 13.36rpx 15.27rpx 9.54rpx;
  background: rgba(255, 255, 255, .96);
  border-top: 1px solid var(--line);
}
.tab-btn {
  border: 0;
  background: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-height: 106.87rpx;
  border-radius: 26.72rpx;
  color: #98988E;
  font-size: 20.04rpx;
  letter-spacing: .05em;
  transition: color .2s cubic-bezier(.22,.61,.36,1);
}
.tab-btn .tab-ico {
  width: 76.34rpx;
  height: 49.62rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 1906.49rpx;
  transition: background .2s cubic-bezier(.22,.61,.36,1), color .2s cubic-bezier(.22,.61,.36,1);
}
.tab-btn.is-on {
  color: var(--green-800); font-weight: 600;
}
.tab-btn.is-on .tab-ico {
  background: var(--green-100); color: var(--green-800);
}
.tab-btn:active, .tab-btn.hs {
  transform: scale(.96);
}
.subnav {
  display: flex;
  align-items: center;
  padding: 15.27rpx 19.08rpx;
  background: rgba(247, 247, 240, .95);
  border-bottom: 1px solid rgba(232, 232, 222, .8);
  position: relative;
  z-index: 10;
}
.subnav .tx-h2 {
  flex: 1;
  margin: 0;
  text-align: center;
  font-size: 29.58rpx;
  font-weight: 600;
}
.icon-btn {
  width: 83.97rpx;
  height: 83.97rpx;
  border: 0;
  background: transparent;
  border-radius: 1906.49rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--ink);
  flex: none;
}
.icon-btn:active, .icon-btn.hs {
  background: rgba(46, 70, 51, .07);
}
.spacer-44 {
  width: 83.97rpx; height: 83.97rpx; flex: none; visibility: hidden;
}
.text-action {
  min-width: 83.97rpx;
  height: 83.97rpx;
  border: 0;
  background: none;
  color: var(--green-800);
  font-size: 23.85rpx;
  font-weight: 600;
  padding: 0 15.27rpx;
}
.home-head {
  display: flex; align-items: center;  padding: 26.72rpx 34.35rpx 0;
}
.brand-seal {
  width: 68.70rpx;
  height: 68.70rpx;
  border-radius: 22.90rpx;
  background: var(--green-800);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  flex: none;
  box-shadow: 0 7.63rpx 22.90rpx rgba(43, 70, 49, .18);
}
.brand-text {
  display: flex; flex-direction: column;  min-width: 0;
}
.brand-name {
  font-family: var(--font-serif); font-size: 36.26rpx; font-weight: 700; letter-spacing: .08em; line-height: 1.2;
}
.brand-sub {
  font-size: 14.31rpx; letter-spacing: .24em; color: var(--brown); line-height: 1.2;
}
.weather-chip {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  min-height: 64.89rpx;
  padding: 0 20.99rpx;
  border: 1px solid var(--line);
  border-radius: 1906.49rpx;
  background: #fff;
  color: var(--muted);
  font-size: 20.99rpx;
  flex: none;
}
.weather-chip .tx-b {
  font-weight: 600; color: var(--ink);
}
.hero {
  position: relative;
  margin: 22.90rpx 34.35rpx 0;
  border-radius: 45.80rpx;
  overflow: hidden;
  background: #344F3A;
  box-shadow: 0 22.90rpx 57.25rpx rgba(43, 70, 49, .14);
}
.hero-slide {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border: 0;
  padding: 0;
  background: none;
  text-align: left;
  opacity: 0;
  pointer-events: none;
  transition: opacity .8s cubic-bezier(.22,.61,.36,1);
  overflow: hidden;
}
.hero-slide.is-active {
  opacity: 1; pointer-events: auto;
}
.hero-slide image {
  width: 100%; height: 100%;
}
.hero-scrim {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(24, 36, 26, .02) 28%, rgba(18, 29, 21, .72) 100%);
  pointer-events: none;
}
.hero-copy {
  position: absolute; left: 34.35rpx; right: 34.35rpx; bottom: 32.44rpx; color: #fff; pointer-events: none;
}
.hero-eyebrow {
  display: block; font-size: 18.13rpx; opacity: .82; margin-bottom: 9.54rpx;
}
.hero-title {
  display: block; font-family: var(--font-serif); font-size: 45.80rpx; font-weight: 700; letter-spacing: .04em; line-height: 1.28; text-shadow: 0 3.82rpx 22.90rpx rgba(0, 0, 0, .28);
}
.hero-meta {
  display: block; margin-top: 9.54rpx; font-size: 20.99rpx; letter-spacing: .04em; opacity: .86;
}
.hero-dots {
  position: absolute;
  right: 17.18rpx;
  bottom: 19.08rpx;
  display: flex;
  align-items: center;
  z-index: 2;
}
.hero-dot {
  width: 38.17rpx;
  height: 45.80rpx;
  border: 0;
  background: none;
  padding: 0;
  display: flex; align-items: center; justify-content: center;
}
.hero-dot .tx-span {
  display: block; width: 9.54rpx; height: 9.54rpx; border-radius: 1906.49rpx; background: rgba(255, 255, 255, .6); box-shadow: 0 1px 5.73rpx rgba(0, 0, 0, .3); transition: width .25s cubic-bezier(.22,.61,.36,1), background .25s cubic-bezier(.22,.61,.36,1);
}
.hero-dot.is-on .tx-span {
  width: 24.81rpx; background: #fff;
}
.searchbar {
  margin: 22.90rpx 34.35rpx 0;
  width: calc(100% - 68.70rpx);
  min-height: 87.79rpx;
  display: flex;
  align-items: center;
  padding: 0 28.63rpx;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 1906.49rpx;
  color: var(--muted);
  font-size: 23.85rpx;
  box-shadow: 0 7.63rpx 30.53rpx rgba(43, 70, 49, .04);
  text-align: left;
}
.searchbar .search-hint {
  flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.searchbar .mini {
  flex: none; font-size: 18.13rpx; color: var(--green-800); background: var(--green-50); padding: 5.73rpx 15.27rpx; border-radius: 1906.49rpx; letter-spacing: .04em;
}
.quick {
  margin: 26.72rpx 34.35rpx 0;
  padding: 26.72rpx 11.45rpx 22.90rpx;
  display: flex;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 38.17rpx;
  box-shadow: var(--sh-card);
}
.quick-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5.73rpx 0;
  border: 0;
  background: none;
  font-size: 21.95rpx;
  color: var(--ink);
  border-radius: 22.90rpx;
}
.quick-btn:active, .quick-btn.hs {
  transform: scale(.97);
}
.quick-ico {
  width: 80.15rpx;
  height: 80.15rpx;
  border-radius: 26.72rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--green-50);
  color: var(--green-700);
}
.quick-btn:nth-child(4) .quick-ico {
  background: var(--sand); color: #7C5E37;
}
.quick-badge {
  position: absolute;
  top: -3px;
  right: 3.82rpx;
  font-size: 15.27rpx;
  color: var(--gold);
  background: var(--gold-bg);
  border-radius: 9.54rpx;
  padding: 1px 7.63rpx;
}
.sec-head {
  display: flex; align-items: flex-end; justify-content: space-between;  margin: 49.62rpx 34.35rpx 22.90rpx;
}
.sec-title {
  margin: 0; font-family: var(--font-serif); font-size: 36.26rpx; font-weight: 700; letter-spacing: .03em; line-height: 1.2;
}
.sec-sub {
  margin: 7.63rpx 0 0; font-size: 20.04rpx; color: var(--muted);
}
.sec-link {
  flex: none;
  display: inline-flex;
  align-items: center;
  min-height: 64.89rpx;
  padding: 0 0 0 11.45rpx;
  border: 0;
  background: none;
  color: var(--green-800);
  font-size: 20.99rpx;
  font-weight: 600;
}
.rail {
  display: flex;  overflow-x: auto;   padding: 0 34.35rpx 7.63rpx;
}
.rail > .rail-item {
  flex: none;
}
.spot-mini {
  width: 297.71rpx;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 34.35rpx;
  background: #fff;
  overflow: hidden;
  text-align: left;
  box-shadow: 0 7.63rpx 26.72rpx rgba(43, 70, 49, .045);
}
.spot-mini:active, .spot-mini.hs {
  transform: scale(.985);
}
.mini-media {
  position: relative; display: block;  overflow: hidden; background: #DDE6D8;
}
.mini-media image {
  width: 100%; height: 100%;
}
.spot-mini .mini-body {
  display: block; padding: 17.18rpx 19.08rpx 20.99rpx;
}
.spot-mini .s-name {
  display: block; font-size: 25.76rpx; font-weight: 600; line-height: 1.3;
}
.spot-mini .s-line {
  display: flex; align-items: center;  margin-top: 9.54rpx; font-size: 18.13rpx; color: var(--brown);
}
.badge-lv {
  position: absolute;
  top: 15.27rpx;
  left: 15.27rpx;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  height: 36.26rpx;
  padding: 0 11.45rpx;
  border-radius: 11.45rpx;
  font-size: 18.13rpx;
  font-weight: 700;
}
.badge-lv.gold {
  background: var(--gold-bg); color: var(--gold);
}
.badge-lv.green {
  background: var(--green-100); color: var(--green-800);
}
.badge-lv.red {
  background: var(--red-bg); color: var(--red);
}
.mosaic {
  display: flex;    margin: 0 34.35rpx;
}
.mosaic-feature {
  position: relative;
  min-height: 377.86rpx;
  border: 0;
  border-radius: 38.17rpx;
  overflow: hidden;
  padding: 0;
  text-align: left;
  background: #344F3A;
}
.mosaic-feature image {
  width: 100%; height: 100%;
}
.mosaic-feature .m-scrim {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(22, 34, 24, .02) 35%, rgba(18, 28, 20, .76) 100%);
}
.mosaic-feature .m-copy {
  position: absolute; left: 24.81rpx; right: 22.90rpx; bottom: 24.81rpx; color: #fff;
}
.mosaic-feature .m-kicker {
  display: block; font-size: 16.22rpx; letter-spacing: .16em; opacity: .8; margin-bottom: 7.63rpx;
}
.mosaic-feature .m-name {
  display: block; font-family: var(--font-serif); font-size: 36.26rpx; font-weight: 700; letter-spacing: .05em;
}
.mosaic-feature .m-desc {
  display: block; margin-top: 5.73rpx; font-size: 18.13rpx; opacity: .82; line-height: 1.45;
}
.mosaic-mini {
  position: relative;
  min-height: 179.39rpx;
  border: 1px solid transparent;
  border-radius: 34.35rpx;
  padding: 24.81rpx 24.81rpx 22.90rpx;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.mosaic-mini.moss {
  background: var(--green-100); color: var(--green-900); border-color: #D8E6D1;
}
.mosaic-mini.sand {
  background: var(--sand); color: var(--sand-ink); border-color: #E9E0D0;
}
.mosaic-mini .mm-top {
  display: flex; align-items: center; justify-content: space-between;
}
.mosaic-mini .mm-icon {
  width: 45.80rpx; height: 45.80rpx; border-radius: 15.27rpx; display: flex; align-items: center; justify-content: center;  background: rgba(255, 255, 255, .55);
}
.mosaic-mini .mm-index {
  font-family: var(--font-serif); font-size: 20.99rpx; opacity: .55;
}
.mosaic-mini .mm-name {
  display: block; font-size: 25.76rpx; font-weight: 600;
}
.mosaic-mini .mm-meta {
  display: block; font-size: 18.13rpx; opacity: .7; margin-top: 3.82rpx;
}
.notice {
  margin: 45.80rpx 34.35rpx 0;
  padding: 26.72rpx 26.72rpx 22.90rpx;
  background: #EDF4E9;
  border: 1px solid #DCE8D6;
  border-radius: 34.35rpx;
}
.notice-head {
  display: flex; align-items: center;  margin-bottom: 9.54rpx; color: var(--green-900); font-size: 22.90rpx; font-weight: 700;
}
.notice-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  padding: 11.45rpx 0;
  border: 0;
  background: none;
  text-align: left;
  font-size: 21.95rpx;
  line-height: 1.55;
  color: #4A5B4C;
}
.notice-dot {
  flex: none; width: 5.73rpx; height: 5.73rpx; border-radius: 50%; background: var(--green-600); margin-top: 15.27rpx;
}
.slogan {
  text-align: center; padding: 64.89rpx 34.35rpx 53.44rpx;
}
.slogan-seal {
  width: 57.25rpx; height: 57.25rpx; margin: 0 auto 20.99rpx; border: 1px solid var(--green-300); border-radius: 17.18rpx; display: flex; align-items: center; justify-content: center;  color: var(--green-700);
}
.slogan-title {
  margin: 0; font-family: var(--font-serif); font-size: 36.26rpx; font-weight: 700; letter-spacing: .18em; color: var(--green-900);
}
.slogan-sub {
  margin: 13.36rpx 0 0; font-size: 17.18rpx; color: var(--brown);
}
.page-head {
  padding: 34.35rpx 34.35rpx 0;
}
.eyebrow {
  margin: 0 0 13.36rpx; font-size: 16.22rpx; letter-spacing: .24em; color: var(--brown); text-transform: uppercase;
}
.page-title {
  margin: 0; font-family: var(--font-serif); font-size: 51.53rpx; font-weight: 700; letter-spacing: .04em; line-height: 1.2;
}
.page-sub {
  margin: 13.36rpx 0 0; font-size: 21.95rpx; line-height: 1.6; color: var(--muted);
}
.chipbar {
  position: sticky; top: 0; z-index: 8; padding: 22.90rpx 0 19.08rpx; background: rgba(247, 247, 240, .93);
}
.chips {
  display: flex;  overflow-x: auto; padding: 0 34.35rpx;
}
.chip {
  flex: none;
  min-height: 76.34rpx;
  padding: 0 26.72rpx;
  border: 1px solid var(--line-strong);
  border-radius: 1906.49rpx;
  background: #fff;
  color: #5E5E54;
  font-size: 21.95rpx;
  transition: background .2s cubic-bezier(.22,.61,.36,1), color .2s cubic-bezier(.22,.61,.36,1), border-color .2s cubic-bezier(.22,.61,.36,1);
}
.chip.is-on {
  background: var(--green-700); border-color: var(--green-700); color: #fff; font-weight: 600;
}
.waterfall {
  padding: 7.63rpx 34.35rpx 0; display: flex;
}
.spot-card {
  display: block;
  width: 100%;
  margin: 0 0 20.99rpx;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 34.35rpx;
  background: #fff;
  overflow: hidden;
  text-align: left;
  box-shadow: 0 9.54rpx 30.53rpx rgba(43, 70, 49, .045);
}
.spot-card:active, .spot-card.hs {
  transform: scale(.985);
}
.spot-card .card-media {
  position: relative; display: block; background: #DDE6D8;
}
.spot-card .card-media image {
  width: 100%; height: auto;
}
.spot-card .card-body {
  display: block; padding: 17.18rpx 19.08rpx 20.99rpx;
}
.spot-card .card-name {
  display: block; font-size: 25.76rpx; font-weight: 600; line-height: 1.35;
}
.spot-card .card-brief {
  margin-top: 5.73rpx; font-size: 19.08rpx; line-height: 1.5; color: var(--muted);
}
.spot-card .card-meta {
  display: flex; align-items: center; justify-content: space-between;  margin-top: 11.45rpx; font-size: 17.18rpx; color: var(--brown);
}
.meta-pin {
  display: inline-flex; align-items: center;  min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.meta-score {
  display: inline-flex; align-items: center;  flex: none;
}
.end-note {
  margin: 41.98rpx 0 11.45rpx; text-align: center; font-size: 19.08rpx; letter-spacing: .08em; color: var(--brown);
}
.custom-hero {
  position: relative;
  display: block;
  width: calc(100% - 68.70rpx);
  margin: 30.53rpx 34.35rpx 0;
  padding: 36.26rpx 34.35rpx;
  text-align: left;
  border: 0;
  border-radius: 41.98rpx;
  overflow: hidden;
  background: #33523A;
  color: #fff;
  box-shadow: 0 22.90rpx 53.44rpx rgba(43, 70, 49, .18);
}
.custom-hero .ch-topo {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; opacity: .16; pointer-events: none;
}
.custom-hero .ch-eyebrow {
  position: relative; display: block; font-size: 16.22rpx; letter-spacing: .22em; opacity: .7;
}
.custom-hero .ch-title {
  position: relative; display: block; margin-top: 13.36rpx; font-family: var(--font-serif); font-size: 40.08rpx; font-weight: 700; letter-spacing: .04em;
}
.custom-hero .ch-desc {
  position: relative; display: block; margin-top: 9.54rpx; font-size: 20.04rpx; line-height: 1.55; opacity: .78; max-width: 78%;
}
.custom-hero .ch-cta {
  position: relative; display: inline-flex; align-items: center;  margin-top: 26.72rpx; padding: 15.27rpx 24.81rpx; border-radius: 1906.49rpx; background: #fff; color: #33523A; font-size: 20.04rpx; font-weight: 700;
}
.route-list {
  display: flex; flex-direction: column;  padding: 30.53rpx 34.35rpx 0;
}
.route-card {
  background: #fff; border: 1px solid var(--line); border-radius: 41.98rpx; overflow: hidden; box-shadow: var(--sh-card);
