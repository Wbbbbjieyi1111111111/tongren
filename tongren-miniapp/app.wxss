}
.route-cover image {
  width: 100%; height: 100%;
}
.route-cover .cover-scrim {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(20, 30, 22, 0) 40%, rgba(20, 30, 22, .28));
}
.route-days {
  position: absolute; top: 20.99rpx; right: 20.99rpx; padding: 7.63rpx 17.18rpx; border-radius: 1906.49rpx; background: rgba(255, 255, 255, .9); color: var(--green-900); font-size: 19.08rpx; font-weight: 700; letter-spacing: .05em;
}
.route-body {
  padding: 24.81rpx 28.63rpx 28.63rpx;
}
.route-body .tx-h3 {
  margin: 0; font-family: var(--font-serif); font-size: 32.44rpx; font-weight: 700; line-height: 1.35;
}
.route-suit {
  display: flex; align-items: center;  margin: 11.45rpx 0 0; font-size: 20.04rpx; color: var(--muted);
}
.route-overview {
  margin: 15.27rpx 0 0; font-size: 21.95rpx; line-height: 1.6; color: #4A4A42;
}
.route-meta {
