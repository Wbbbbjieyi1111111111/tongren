<view class="sub-page">

  <!-- 自定义导航 -->
  <view class="subnav" style="padding-top:{{statusBar}}px">
    <view class="icon-btn" hover-class="hs" bindtap="onBack">
      <image class="ico i21" src="{{icons.back}}" mode="aspectFit" />
    </view>
    <text class="tx-h2">{{user ? '我的' : '登录 / 注册'}}</text>
    <view class="spacer-44"></view>
  </view>

  <!-- 页面标题 -->
  <view class="page-head">
    <view class="tx-p eyebrow">WELCOME · TONGREN</view>
    <view class="tx-h1 page-title">{{user ? '欢迎回来' : '欢迎来到大美铜仁'}}</view>
    <view class="tx-p page-sub">{{user ? '你的收藏与行程已同步保存。' : '登录后可同步收藏与行程，随时续游铜仁。'}}</view>
  </view>

  <!-- 未登录：登录 / 注册表单 -->
  <view class="auth-card" wx:if="{{!user}}">
    <view class="seg">
      <view class="seg-item {{mode === 'login' ? 'is-on' : ''}}" hover-class="hs" bindtap="onModeTap" data-mode="login">
        <text class="tx-span">登录</text>
      </view>
      <view class="seg-item {{mode === 'register' ? 'is-on' : ''}}" hover-class="hs" bindtap="onModeTap" data-mode="register">
        <text class="tx-span">注册</text>
      </view>
    </view>

    <view class="field">
      <view class="tx-p field-label">手机号</view>
      <view class="field-box">
        <image class="ico i18" src="{{icons.phone}}" mode="aspectFit" />
        <input type="number" maxlength="11" placeholder="请输入 11 位手机号" placeholder-class="ph"
               value="{{phone}}" bindinput="onPhoneInput" />
      </view>
    </view>

    <view class="field">
      <view class="tx-p field-label">密码</view>
      <view class="field-box">
        <image class="ico i18" src="{{icons.shield}}" mode="aspectFit" />
        <input password placeholder="6 – 32 位密码" placeholder-class="ph"
               value="{{password}}" bindinput="onPasswordInput" />
      </view>
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <view class="tx-p field-label">昵称（选填）</view>
      <view class="field-box">
        <image class="ico i18" src="{{icons.users}}" mode="aspectFit" />
        <input maxlength="16" placeholder="不填将自动生成" placeholder-class="ph"
               value="{{nickname}}" bindinput="onNicknameInput" />
      </view>
    </view>

    <view class="btn-primary {{submitting ? 'is-off' : ''}}" hover-class="hs" bindtap="onSubmit">
      <text class="tx-span">{{submitting ? '提交中…' : (mode === 'login' ? '登 录' : '注册并登录')}}</text>
    </view>
    <view class="tx-p hint">登录即代表同意《用户协议》与《隐私政策》</view>
  </view>

  <!-- 已登录：账号卡 -->
  <view class="auth-card" wx:else>
    <view class="profile-row">
      <view class="avatar-seal">
        <image class="ico i26" src="{{icons.seal}}" mode="aspectFit" />
      </view>
      <view class="profile-meta">
        <text class="tx-b profile-name">{{user.nickname}}</text>
        <text class="tx-span profile-phone">{{user.phone}}</text>
      </view>
      <view class="badge-on">
        <text class="tx-span">已登录</text>
      </view>
    </view>

    <view class="btn-primary" hover-class="hs" bindtap="onGoHome">
      <text class="tx-span">开始探索铜仁</text>
    </view>
    <view class="btn-ghost" hover-class="hs" bindtap="onLogout">
      <text class="tx-span">退出登录</text>
    </view>
  </view>

  <!-- 品牌落款 -->
  <view class="login-seal">
    <image class="seal-img" src="{{sealImgUrl}}" mode="widthFix" />
    <text class="tx-p seal-text">一城三族 · 各有声色</text>
  </view>

</view>
